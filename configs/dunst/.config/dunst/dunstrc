[global]
    monitor = 0
    follow = keyboard
    width = (250, 500)
    height = (0, 750)
    offset = (17, 26)
    padding = 5
    horizontal_padding = 5
    gap_size = 3
    transparency = 35
    frame_width = 2
    frame_color="#FBF1C7"
    font = Iosevka Nerd Font 12
    corner_radius = 0
    min_icon_size = 32
    max_icon_size = 32
    format = "<b>%s</b>\n%b"

[urgency_low]
    foreground = "#FBF1C7"
    background = "#282828"
    timeout = 3

[urgency_normal]
    foreground = "#FBF1C7"
    background = "#3C3836"
    timeout = 5

[urgency_critical]
    background = "#7C6F64"
    foreground = "#FE8019"
    frame_color = "#FE8019"
    timeout = 15

{ 
    "layer": "top",
    "position": "top",
    "spacing": 5,
    "height": 25,
    "fixed-center": true,
    "margin-top": 0,
    "margin-left": 0,
    "margin-right": 0,

    "modules-left": [
        "group/Utilities",
        "group/workspaces"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "mpris",
        "group/battery",
        "group/langvol"
    ],

    // --- WIDGETS CONFIG ---

    "custom/openbracket": {
        "format": "[",
        "tooltip": false
    },

    "custom/closebracket": {
        "format": "]",
        "tooltip": false
    },

    "custom/split": {
        "format": "|",
        "tooltip": false
    },

    "group/Utilities": {
        "orientation": "horizontal",
        "modules": [
            "custom/openbracket",
            "custom/arch",
            "tray",
            "custom/closebracket"
        ]
    },

    "custom/arch": {
        "format": "󰣇",
        "tooltip": false,
        "on-click": "rofi -show drun"
    },

    "group/workspaces": {
        "orientation": "horizontal",
        "modules": [
            "custom/openbracket",
            "hyprland/workspaces",
            "custom/closebracket"
        ]
    },

    "group/battery": {
        "orientation": "horizontal",
        "modules": [
            "custom/openbracket",
            "battery",
            "custom/closebracket"
        ]
    },

    "battery": {
        "states": { "warning": 20, "critical": 10 },
        "format": "{icon} : {capacity}%",
        "format-charging": " : {capacity}%",
        "format-plugged": " : {capacity}%",
        "format-icons": ["", "", "", "", ""]
    },

    // Restored Clock module with fixed calendar tooltip and click
    "clock": {
        "format": "[ {:%I:%M} ]",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "onclick" : "kalender"
    },

    "group/langvol": {
        "orientation": "horizontal",
        "modules": [
            "custom/openbracket",
            "hyprland/language",
            "custom/split",
            "backlight",
            "custom/split",
            "wireplumber",
            "custom/closebracket"
        ]
    },

    "backlight": {
        "device": "intel_backlight",
        "format": "{icon} : {percent}%",
        "format-icons": ["󰃞", "󰃟", "󰃠"],
        "on-scroll-up": "swayosd-client --brightness raise",
        "on-scroll-down": "swayosd-client --brightness lower"
    },

    "wireplumber": {
        "scroll-step": 2,
        "format": "{icon}{volume}%",
        "format-bluetooth": "{icon}{volume}% ",
        "format-bluetooth-muted": " {icon}",
        "format-muted": "",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": [" :", " :", " :"]
        },
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click": "flatpak run com.saivert.pwvucontrol"
    },

    "hyprland/workspaces": {
        "all-outputs": true,
        "format": "{icon}",
        "persistent-workspaces": { "*": 4 }
    },

    "mpris": {
        "format": "[   {status_icon} | {dynamic} ]",
        "status-icons": { "playing": "▶", "paused": "⏸", "stopped": "" }
    },
    
    "tray": {
        "spacing": 10
    },

    "hyprland/language": {
        "format": "{}",
        "format-en": "EN",
        "format-pt": "BR",
        "on-click": "hyprctl switchxkblayout at-translated-set-2-keyboard next"
    }
}
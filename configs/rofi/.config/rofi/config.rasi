@theme "/usr/share/rofi/themes/gruvbox-dark-soft.rasi"

configuration {
    modi:                        "drun";
    show-icons:                  true;
    display-drun:                "Looking for"; 
    sorting-method:              "fzf";
    disable-history:             false;
    drun-display-format: 	 "{icon} {name}";
    icon-theme:                  "Colloid-Gruvbox";
    terminal:		         "kitty";
}

window {
    width:                        700px;
    height:                       400px;
    border-radius:                0;
    border:                       2px;
}

element-icon {
    size:             52px;          
    cursor:           inherit;
    background-color: transparent;
    text-color:       inherit;
}

element-text {
    vertical-align:   0.5;           
    cursor:           inherit;
    background-color: transparent;
    text-color:       inherit;
}
